# ==========================================================================
# SevaSetu — Web (Public Website + Admin Panel)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Platform architecture:
#   Firebase Authentication  -> identity (the only auth provider)
#   Firebase Storage         -> all application media and documents
#   Supabase PostgreSQL      -> business data, RLS, Realtime, Edge Functions
# ==========================================================================

# --------------------------------------------------------------------------
# Firebase — client configuration
# --------------------------------------------------------------------------
# Sign-in methods, for every surface (customer app, worker app, website, admin):
#   1. Phone OTP  — enable "Phone" in Firebase Console > Authentication
#   2. Google     — enable "Google" in Firebase Console > Authentication
# There is no password authentication anywhere on this platform, so there is no
# password to phish, leak, or reset.
#
# Also add every deployment hostname to
# Firebase Console > Authentication > Settings > Authorized domains,
# otherwise Google sign-in and the reCAPTCHA used by phone OTP will be refused.
#
# These values are public by design; they identify the project, they do not
# authorize anything. Access control comes from Firebase Security Rules,
# Supabase RLS, and the server-side authorization layer.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --------------------------------------------------------------------------
# Firebase Admin SDK — SERVER ONLY
# --------------------------------------------------------------------------
# Used to verify Firebase ID tokens, mint httpOnly session cookies, and sign
# short-lived Storage URLs. These MUST NOT be prefixed with NEXT_PUBLIC_ and
# must never be imported from a client component.
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full PEM including the BEGIN/END lines. Literal \n escapes are
# accepted and normalised at load time (Vercel env vars cannot hold newlines).
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Bucket the Admin SDK signs URLs against. Usually the same as the client value.
FIREBASE_ADMIN_STORAGE_BUCKET=your-project.firebasestorage.app

# Lifetime of the httpOnly Firebase session cookie, in seconds.
# Firebase allows 5 minutes to 14 days. Admin sessions are deliberately short.
FIREBASE_SESSION_COOKIE_MAX_AGE=28800

# --------------------------------------------------------------------------
# Supabase — database, Realtime, Edge Functions (NOT auth, NOT storage)
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. The web tier uses this only after a
# Firebase ID token has been verified and the caller's permissions resolved, and
# every privileged mutation still re-checks authorization inside the database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Third-Party Auth: Supabase validates Firebase ID tokens against
# Google's JWKS for this project, so auth.jwt()->>'sub' is the Firebase UID and
# RLS applies to direct client access from the Flutter apps.
# Configure in Supabase Dashboard > Authentication > Third-Party Auth > Firebase.
SUPABASE_THIRD_PARTY_AUTH_FIREBASE_PROJECT_ID=your-project

# --------------------------------------------------------------------------
# Domain / routing architecture
# --------------------------------------------------------------------------
# Phase 1 (single deployment): both point at the same origin, admin lives at /admin.
# Phase 2 (subdomain split): set NEXT_PUBLIC_ADMIN_BASE_URL=https://admin.yourdomain.com,
#   ADMIN_HOST=admin.yourdomain.com and NEXT_PUBLIC_ADMIN_PATH_PREFIX="" — no code changes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Route prefix the admin panel is mounted under. "/admin" today, "" after the
# subdomain migration. Leading slash, no trailing slash.
NEXT_PUBLIC_ADMIN_PATH_PREFIX=/admin

# When set, requests arriving on this hostname are rewritten to the admin surface
# and the public website is not served from it. Leave empty in Phase 1.
ADMIN_HOST=

# Cookie domain for the Firebase session cookie. Empty = host-only (Phase 1).
# For a subdomain split where one session should span both hosts, use
# ".yourdomain.com" — but prefer a separate admin session cookie.
AUTH_COOKIE_DOMAIN=

# --------------------------------------------------------------------------
# Brand / company information shown on the public website
# --------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=Wervexa
NEXT_PUBLIC_BRAND_TAGLINE=Verified home-service professionals, near you
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=

# --------------------------------------------------------------------------
# Mobile application deep links (leave empty to hide the CTA entirely —
# the UI must never render a fake store URL)
# --------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOMER_APP_ANDROID_URL=
NEXT_PUBLIC_CUSTOMER_APP_IOS_URL=
NEXT_PUBLIC_WORKER_APP_ANDROID_URL=
NEXT_PUBLIC_WORKER_APP_IOS_URL=

# --------------------------------------------------------------------------
# Feature flags
# --------------------------------------------------------------------------
CONTACT_FORM_ENABLED=true
NEXT_PUBLIC_ADMIN_REALTIME_ENABLED=true

# --------------------------------------------------------------------------
# Operational
# --------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
